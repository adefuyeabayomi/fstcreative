# Base URL for the marketing legacy API (src/services/*).
NEXT_PUBLIC_API_BASE_URL=

# Public site URL used for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express backend used for auth + dashboard data. The Next.js server proxies
# /api/* here (server-side only; not exposed to the browser).
API_PROXY_TARGET=http://localhost:5100

# Google OAuth client id (same value as GOOGLE_CLIENT_ID in fst_backend).
# When empty, the Google buttons show a "not configured" notice.
#464298799889-2ppau6po2jbn8dm95kf2hfhgjmh3v1p3.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
